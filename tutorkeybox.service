[Unit]
Description=TutorKeybox Headless Audio Core Daemon
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/TutorKeyBox01
ExecStart=/home/pi/TutorKeyBox01/build/TutorKeyboxCore_artefacts/Release/TutorKeyboxCore
Restart=always
RestartSec=3
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
